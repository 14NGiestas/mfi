#:def gesv(NAME,pfxs)
#:set wp=pfxs[0]
pure subroutine ${NAME}$(n, nrhs, a, lda, ipiv, b, ldb, info)
    import :: ${kind(wp)}$
    integer, intent(in) :: n, nrhs, lda, ldb
    ${type(wp)}$, intent(inout) :: a(lda,*), b(ldb,*)
    integer, intent(out) :: ipiv(*)
    integer, intent(out) :: info
end subroutine
#:enddef
